{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-agent.local/schemas/governed_shell/command_proposal.v1.json",
  "title": "Governed Shell Command Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "created_at",
    "requested_execution_mode",
    "intent",
    "proposer",
    "path_refs",
    "operations",
    "model_annotations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "command_proposal.v1"
    },
    "proposal_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_execution_mode": {
      "type": "string",
      "enum": [
        "simulate",
        "local_execute"
      ]
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "proposer": {
      "$ref": "#/$defs/proposer"
    },
    "path_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathRef"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "model_annotations": {
      "$ref": "#/$defs/modelAnnotations"
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "bindingIdentifier": {
      "allOf": [
        {
          "$ref": "#/$defs/safeIdentifier"
        },
        {
          "not": {
            "enum": [
              "Invoke-Expression",
              "invoke-expression",
              "Start-Process",
              "start-process",
              "powershell",
              "PowerShell",
              "pwsh",
              "cmd",
              "cmd.exe",
              "iex",
              "IEX"
            ]
          }
        }
      ]
    },
    "hashString": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[^\\r\\n]+$",
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.($|[\\\\/])"
          }
        }
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "justification",
        "requested_effect"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requested_effect": {
          "type": "string",
          "enum": [
            "inspect",
            "simulate",
            "prepare_local_execution"
          ]
        }
      }
    },
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "proposal_only",
        "agent_family",
        "agent_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "proposal_only": {
          "const": true
        },
        "agent_family": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "agent_id": {
          "$ref": "#/$defs/safeIdentifier"
        }
      }
    },
    "pathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_ref_id",
        "root_id",
        "relative_path",
        "path_kind",
        "must_exist"
      ],
      "properties": {
        "path_ref_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "root_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "path_kind": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "must_exist": {
          "type": "boolean"
        }
      }
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value_type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "number",
            "integer",
            "path_ref"
          ]
        },
        "string_value": {
          "type": "string",
          "maxLength": 2000
        },
        "boolean_value": {
          "type": "boolean"
        },
        "number_value": {
          "type": "number"
        },
        "integer_value": {
          "type": "integer"
        },
        "path_ref": {
          "$ref": "#/$defs/safeIdentifier"
        }
      },
      "oneOf": [
        {
          "required": [
            "string_value"
          ],
          "properties": {
            "value_type": {
              "const": "string"
            }
          }
        },
        {
          "required": [
            "boolean_value"
          ],
          "properties": {
            "value_type": {
              "const": "boolean"
            }
          }
        },
        {
          "required": [
            "number_value"
          ],
          "properties": {
            "value_type": {
              "const": "number"
            }
          }
        },
        {
          "required": [
            "integer_value"
          ],
          "properties": {
            "value_type": {
              "const": "integer"
            }
          }
        },
        {
          "required": [
            "path_ref"
          ],
          "properties": {
            "value_type": {
              "const": "path_ref"
            }
          }
        }
      ]
    },
    "powershellCmdletOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "cmdlet_id",
        "parameters"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "powershell_cmdlet"
        },
        "cmdlet_id": {
          "allOf": [
            {
              "$ref": "#/$defs/bindingIdentifier"
            },
            {
              "not": {
                "enum": [
                  "-Command",
                  "-command"
                ]
              }
            }
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "registeredScriptOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "script_id",
        "execution_mode",
        "arguments"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "registered_script"
        },
        "script_id": {
          "$ref": "#/$defs/bindingIdentifier"
        },
        "execution_mode": {
          "const": "dry_run"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "registeredNativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "native_id",
        "arguments"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "registered_native"
        },
        "native_id": {
          "$ref": "#/$defs/bindingIdentifier"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/powershellCmdletOperation"
        },
        {
          "$ref": "#/$defs/registeredScriptOperation"
        },
        {
          "$ref": "#/$defs/registeredNativeOperation"
        }
      ]
    },
    "modelAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_source"
      ],
      "properties": {
        "proposal_source": {
          "type": "string",
          "enum": [
            "human_authored",
            "model_authored",
            "hybrid"
          ]
        },
        "model_declared_risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        },
        "proposal_hash_hint": {
          "$ref": "#/$defs/hashString"
        }
      }
    }
  }
}
