{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-agent.local/schemas/governed_shell/execution_plan.v1.json",
  "title": "Governed Shell Execution Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "session_id",
    "proposal_id",
    "proposal_hash",
    "proposal_canonical",
    "policy_hash",
    "decision",
    "matched_binding_id",
    "effective_risk",
    "confirmation",
    "network_allowed",
    "privilege_escalation_allowed",
    "declared_reads",
    "declared_writes",
    "operations",
    "plan_hash"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "execution_plan.v1"
    },
    "plan_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "proposal_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "proposal_hash": {
      "$ref": "#/$defs/hashString"
    },
    "proposal_canonical": {
      "type": "string",
      "minLength": 2
    },
    "policy_hash": {
      "$ref": "#/$defs/hashString"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "require_confirmation"
      ]
    },
    "matched_binding_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "effective_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "network_allowed": {
      "type": "boolean"
    },
    "privilege_escalation_allowed": {
      "type": "boolean"
    },
    "declared_reads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaredSurface"
      }
    },
    "declared_writes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaredSurface"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "plan_hash": {
      "$ref": "#/$defs/hashString"
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "hashString": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode",
        "proposal_hash",
        "supplied_hash",
        "matched",
        "reason_code",
        "issues"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "session_confirmation",
            "exact_proposal_hash"
          ]
        },
        "proposal_hash": {
          "$ref": "#/$defs/hashString"
        },
        "supplied_hash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hashString"
            }
          ]
        },
        "matched": {
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "declaredSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "parameter",
        "path_ref_id",
        "root_id",
        "relative_path"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "parameter": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "path_ref_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "root_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[^\\r\\n]+$",
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.($|[\\\\/])"
          }
        }
      ]
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value_type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "number",
            "integer",
            "path_ref"
          ]
        },
        "string_value": {
          "type": "string",
          "maxLength": 2000
        },
        "boolean_value": {
          "type": "boolean"
        },
        "number_value": {
          "type": "number"
        },
        "integer_value": {
          "type": "integer"
        },
        "path_ref": {
          "$ref": "#/$defs/safeIdentifier"
        }
      },
      "oneOf": [
        {
          "required": [
            "string_value"
          ],
          "properties": {
            "value_type": {
              "const": "string"
            }
          }
        },
        {
          "required": [
            "boolean_value"
          ],
          "properties": {
            "value_type": {
              "const": "boolean"
            }
          }
        },
        {
          "required": [
            "number_value"
          ],
          "properties": {
            "value_type": {
              "const": "number"
            }
          }
        },
        {
          "required": [
            "integer_value"
          ],
          "properties": {
            "value_type": {
              "const": "integer"
            }
          }
        },
        {
          "required": [
            "path_ref"
          ],
          "properties": {
            "value_type": {
              "const": "path_ref"
            }
          }
        }
      ]
    },
    "powershellCmdletOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "cmdlet_id",
        "parameters"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "powershell_cmdlet"
        },
        "cmdlet_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "registeredScriptOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "script_id",
        "execution_mode",
        "arguments"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "registered_script"
        },
        "script_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "execution_mode": {
          "const": "dry_run"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "registeredNativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "operation_type",
        "native_id",
        "arguments"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "operation_type": {
          "const": "registered_native"
        },
        "native_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedValue"
          }
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/powershellCmdletOperation"
        },
        {
          "$ref": "#/$defs/registeredScriptOperation"
        },
        {
          "$ref": "#/$defs/registeredNativeOperation"
        }
      ]
    }
  }
}
