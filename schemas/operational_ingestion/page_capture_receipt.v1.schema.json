{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-agent.local/schemas/operational_ingestion/page_capture_receipt.v1.schema.json",
  "title": "Exact operational page-capture receipt",
  "type": "object",
  "required": ["schema_version", "artifact_id", "capture_id", "session_id", "attempt", "previous_capture", "page_ordinal", "request_fingerprint", "continuation_hash", "captured_at", "response_schema", "media_type", "response_body", "response_metadata", "terminal", "next_continuation", "observations", "secret_material_persisted", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "signal_agent.operational_page_capture_receipt.v1"},
    "artifact_id": {"type": "string", "pattern": "^opc_[0-9a-f]{20}$"},
    "capture_id": {"type": "string", "pattern": "^opc_[0-9a-f]{20}$"},
    "session_id": {"type": "string", "pattern": "^oas_[0-9a-f]{20}$"},
    "attempt": {"type": "object"},
    "previous_capture": {"type": ["object", "null"]},
    "page_ordinal": {"type": "integer", "minimum": 1},
    "request_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "continuation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "minLength": 1},
    "response_schema": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "response_body": {"type": "object"},
    "response_metadata": {"type": "object"},
    "terminal": {"type": "boolean"},
    "next_continuation": {"type": "object"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "secret_material_persisted": {"const": false},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
