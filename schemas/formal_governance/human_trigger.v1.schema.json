{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_trigger.v1.schema.json",
  "title": "HumanTrigger",
  "type": "object",
  "required": ["trigger_id", "actor_id", "actor_type", "role", "scope", "approval_status", "timestamp"],
  "properties": {
    "trigger_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_type": { "type": "string", "enum": ["human", "agent", "generator", "model"] },
    "role": { "type": "string" },
    "scope": { "type": "string" },
    "approval_status": { "type": "string", "enum": ["approved", "rejected", "pending"] },
    "timestamp": { "type": "string" },
    "self_certified": { "type": "boolean" }
  },
  "additionalProperties": false
}

