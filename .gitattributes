# Normalize line endings in repo; allow Windows working tree CRLF
* text=auto
.gitattributes text eol=lf

# Force LF for source files in repo
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.jinja text eol=lf
*.j2   text eol=lf
tests/fixtures/interaction_events/events.jsonl text eol=lf
tests/fixtures/interaction_events/compatibility_witness_v1.json text eol=lf
